rules_version = '2';

// ---------------------------------------------------------------------------
// TaskCaster Firebase Storage rules — cost controls for in-app video.
//
// WHY this file exists at all: the owner approved Firebase Storage for
// in-app video with a HARD $100/month ceiling (GCP budget
// `taskcaster-video-ceiling-100`, alerts at 50/90/100 %). Since WP-11
// (audit 2026-11-05) clips are NOT kept forever: the sweepClipRetention
// Cloud Function deletes free clips after 90 days (keepers after a year) and
// a lapsed Pro user's clips no later than a year after the lapse
// (functions/src/retention.js). The controls below are the upload side:
//
//   - PLAN-AWARE CAPS (WP-11). The plan is read from the server-owned
//     users/{uid}.plan / planExpiresAt fields (firestore.get, so a cross-
//     service rules read) — fields only Cloud Functions can write:
//       guest (anonymous auth)  submissions/{uid}/guest/{0-4}   5 clips, ever
//       free                    submissions/{uid}/{today}/{0-2} 3 a day, 32 MiB
//       pro                     submissions/{uid}/{today}/{0-9,a-e} 15 a day, 96 MiB
//     Clip LENGTH cannot be checked here; the transcode trims to the plan cap
//     (20 s guest/free, 60 s Pro) on the server.
//   - `create`-only (no `update`) is what makes the per-day slots a REAL cap.
//     If overwriting an existing slot were allowed, a client could re-upload
//     the same slot forever and blow past the daily/size budget the slot
//     scheme is meant to enforce. `video_uploader.dart` walks the plan's
//     slots in order; refusing overwrite means the create after the last slot
//     has nowhere left to land and fails. See "OVERWRITE PROTECTION" below
//     for how this is actually enforced at the bucket level.
//   - the per-plan `request.resource.size` cap bounds the upload; the 720p
//     transcode (WP-08) that replaces it in place bounds storage and egress.
//   - the `video/.*` content-type check keeps non-video blobs (large images,
//     zips, etc.) from being smuggled into a path sized for a clip.
//   - the day must be TODAY (server clock, UTC) and the slot a single
//     character, so the only writable paths are `submissions/{uid}/{today}/{slot}`
//     and the 5-slot guest folder: a bug or a hostile client can't fan out
//     into unbounded object counts with made-up dates.
//   - no client delete, so a used slot can't be freed and refilled.
//   - the caps above, the retention sweep, and the $100 GCP budget alarm
//     (`taskcaster-video-ceiling-100`, 50/90/100 %) are the cost model:
//     bounded per-user upload volume, bounded stored lifetime, and a human
//     notified before spend gets away from either.
//   - everything outside the sanctioned prefixes below (`submissions/**`,
//     `transcoded/**`, `house/**`, `montages/**`) is denied entirely: there is no other
//     sanctioned use of this bucket, and an open bucket is an open line item
//     on the budget.
//
// OVERWRITE PROTECTION: Firebase Storage Security Rules classify any write
// to file *contents* — including an overwrite of an existing object — as
// `create`, not `update`; `resource` is null (so the `create` rule is what
// runs) on every content write UNLESS the bucket has GCS Object Versioning
// enabled, in which case a write to an existing path is correctly evaluated
// as `update` instead. The orchestrator has enabled Object Versioning on
// `gs://taskmaster-app-3d480.firebasestorage.app`, paired with a lifecycle
// rule that deletes only NONCURRENT versions after 1 day (the live/current
// version of every object is never touched by that rule; live clips are
// removed only by the retention sweep or account deletion). With versioning
// on, a second write to an already-created `submissions/{uid}/{day}/{slot}`
// path is classified as `update`, which `allow update: if false` below
// denies — so the create-only slot scheme is a REAL per-day cap in
// production. The Firebase Storage emulator does not implement Object
// Versioning, so it always evaluates a same-path rewrite as `create`; the
// explicit `resource == null` guard in the create rule is what denies it
// there, and `test/rules/storage.test.js` ("accepted once; a second write to
// it is denied") exercises that guard. See docs/FIREBASE_SETUP.md "Video
// storage and cost controls" for the write-up.
// ---------------------------------------------------------------------------

service firebase.storage {
  match /b/{bucket}/o {

    // Two-digit zero padding for todayKey().
    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // Today's date as yyyyMMdd in UTC, from the SERVER clock. Mirrors
    // VideoPolicy.dayKey() in lib/core/services/video/video_policy.dart.
    function todayKey() {
      return string(request.time.year()) +
             pad2(request.time.month()) +
             pad2(request.time.day());
    }

    // Size caps per plan (WP-11). The free cap is the pre-WP-11 cap: the app
    // uploads what the OS recorder produced (no client re-encode), and a 20 s
    // phone clip is routinely over 12 MiB. Storage cost is set by the 720p
    // transcode that replaces the upload in place, not by the upload size.
    function freeMaxBytes() {
      return 32 * 1024 * 1024;
    }

    function proMaxBytes() {
      return 96 * 1024 * 1024;
    }

    // An anonymous (guest) Firebase Auth session.
    function isAnonymous() {
      return request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous';
    }

    // Active Pro: the server-owned plan fields on users/{uid}, same test as
    // functions/src/plans.js effectivePlan(). A missing doc is free. Only
    // evaluated when a free slot would not do (short-circuit), so a free
    // user's upload costs no Firestore read.
    function isPro(uid) {
      let user = firestore.get(/databases/(default)/documents/users/$(uid));
      return user != null &&
             user.data.get('plan', 'free') == 'pro' &&
             (user.data.get('planExpiresAt', null) == null ||
              user.data.planExpiresAt > request.time);
    }

    function isVideoUnder(maxBytes) {
      return request.resource.size <= maxBytes &&
             request.resource.contentType.matches('video/.*');
    }

    // Player video submissions: submissions/{uid}/{yyyyMMdd}/{slot}, and the
    // guest folder submissions/{uid}/guest/{slot}.
    //
    // WP-04 (audit 2026-11-05) closed three holes in the "10 clips/day" cap:
    //   1. `day` used to be any 8 digits, so one uid had 10 fresh slots per
    //      FAKE date (19990101, 19990102, ...): unbounded uploads. `day` must
    //      now equal today's date in UTC, taken from the server's
    //      `request.time`, so there is exactly one writable day folder per uid.
    //   2. Owner delete freed a slot for reuse, so delete + re-upload was an
    //      unbounded loop inside that one day. Client delete is now denied;
    //      clips are removed only with the Admin SDK (the account-deletion
    //      Cloud Function, WP-01) or by the owner from the console.
    //   3. `list` was open on every prefix, so anyone could enumerate every
    //      stored clip, including ones posted to private games. Only `get`
    //      (download / getDownloadURL of a path you already know) is allowed.
    //
    // `slot` binds as a plain string here (single-segment wildcard), so a
    // deeper path like `.../0/extra` never matches this block, and a `list`
    // of a uid or day prefix matches nothing but the deny-all at the bottom.
    match /submissions/{uid}/{day}/{slot} {
      // Public get: clips are public Arena content once posted. No list.
      allow get: if true;
      allow list: if false;

      // Create-only: the owner, writing their own uid, as a video under the
      // plan's size cap, into
      //   - a guest:      the lifetime guest folder, slots 0-4 (5 clips ever;
      //                   signing in free unlocks the daily slots, same uid);
      //   - signed in:    TODAY's folder (UTC, server clock), slots 0-2, or
      //                   with active Pro slots 0-9 and a-e (15 a day).
      allow create: if request.auth != null &&
                       request.auth.uid == uid &&
                       // Explicit no-overwrite guard: a production probe showed
                       // a second upload to an existing slot is still evaluated
                       // as `create` even with Object Versioning on, so the
                       // slot must be empty for the write to be allowed.
                       resource == null &&
                       (
                         (isAnonymous() &&
                          day == 'guest' &&
                          slot.matches('^[0-4]$') &&
                          isVideoUnder(freeMaxBytes())) ||
                         (!isAnonymous() &&
                          day == todayKey() &&
                          ((slot.matches('^[0-2]$') && isVideoUnder(freeMaxBytes())) ||
                           (slot.matches('^[0-9a-e]$') && isVideoUnder(proMaxBytes()) &&
                            isPro(uid))))
                       );

      // Never allowed. An object is created once and never replaced in place
      // (see OVERWRITE PROTECTION above), and never deleted by a client: a
      // delete would free the slot for another upload the same day.
      allow update, delete: if false;
    }

    // Seeded "house" video clips (e.g. house/starter-01.mp4) — short,
    // pre-rendered filler clips for the starter-pack house entries. Public
    // read, like player submissions, so they play in the Arena the same way.
    // Write is never allowed through client rules: these are placed directly
    // in the bucket out-of-band (not by app users), so there is no
    // sanctioned client write path at all.
    match /house/{file} {
      allow read: if true;
      allow write: if false;
    }

    // Poster frames for transcoded clips (WP-08):
    // transcoded/{uid}/{day}/{slot}.jpg, written by the onClipUploaded Cloud
    // Function with the Admin SDK (which bypasses these rules). The clip
    // itself is NOT here: the function re-encodes it to 720p H.264 SDR IN
    // PLACE at submissions/{uid}/{day}/{slot}, so the slot stays occupied (a
    // delete would free it and leak the daily cap above) and every existing
    // download URL keeps working. Public get like the clip; no list; no
    // client write of any kind.
    match /transcoded/{uid}/{day}/{file} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Server-rendered montages (the per-task "finale" and "moments reel").
    // Public read, same as the clips they're assembled from. Write is never
    // allowed through client rules: a Cloud Function writes these with the
    // Admin SDK, which bypasses Storage Security Rules entirely — so
    // `allow write: if false` here only blocks *client* writes, which is
    // exactly right (no app user should ever be able to place or replace a
    // montage).
    match /montages/{gameId}/{taskId}/{file} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else in the bucket: no sanctioned use, so no access. Keeping
    // this explicit (rather than relying on Storage's implicit default-deny)
    // documents that any future path added here needs its own cost review.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
