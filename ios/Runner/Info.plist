<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>TaskCaster</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>taskcaster_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!-- URL schemes. The first is REVERSED_CLIENT_ID from
	     GoogleService-Info.plist: GoogleSignIn on iOS hands the OAuth result
	     back through it and throws "missing support for the following URL
	     schemes" (killing the app) when it is absent. Keep it in sync if the
	     iOS OAuth client is ever regenerated. The second is the app's own
	     scheme for invite deep links (taskcaster://...). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google-sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.488967944620-lhugdf44nsemgruva1s0p8kkpo2cd6mc</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.sagearbor.taskcaster</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>taskcaster</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Invite links (custom scheme + Universal Links) are delivered to Dart by
	     the app_links plugin (PendingInviteService). Flutter's own deep-link
	     routing must stay off: it would push the URL path as a named route,
	     which this app (home: only, no route table) cannot resolve. -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>This app uses the camera to snap photos and film short clips for your task entries, and to play augmented-reality (AR) party tasks like Balloon Pop.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Location is only used by location-based AR party tasks while you play one. TaskCaster never tracks you in the background or stores your location.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Location is only used by location-based AR party tasks, to place a task where you are. TaskCaster never tracks you or stores your location.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>This app records sound with your short task clips so your entry is funny with the audio on.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>This app can pick a clip or photo you already filmed, so you can enter a task with something from your camera roll.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
