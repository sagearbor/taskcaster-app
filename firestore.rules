rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    // True if the named top-level field is identical before and after the write.
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ---- Games ----
    // Read: any signed-in user (needed for join-by-invite-code lookups).
    // Privacy of individual video submissions is enforced at the app level.
    match /games/{gameId} {
      allow read: if isSignedIn();

      // A user may only create a game they own.
      allow create: if isSignedIn() &&
                       request.resource.data.creatorId == request.auth.uid;

      // The creator and judge have full update rights (scores, status, tasks).
      // Now that games carry a flat playerIds array, an actual participant is
      // also allowed to update (submitting answers, AR results). Anyone else
      // may still write ONLY if they leave ownership/judge/invite code intact —
      // this is what lets a NOT-yet-member join (they add themselves to
      // players/playerIds without changing ownership) and blocks hijacking.
      allow update: if isSignedIn() && (
        // Owner / judge: full rights.
        request.auth.uid == resource.data.creatorId ||
        request.auth.uid == resource.data.judgeId ||
        // Existing participant (member of the flat playerIds list).
        (resource.data.playerIds is list &&
         request.auth.uid in resource.data.playerIds) ||
        // Non-member (e.g. a joining player) may write only without seizing
        // ownership, swapping the judge, or rewriting the invite code.
        (unchanged('creatorId') && unchanged('judgeId') && unchanged('inviteCode'))
      );

      // Only the creator can delete a game.
      allow delete: if isSignedIn() && request.auth.uid == resource.data.creatorId;
    }

    // ---- Drawing Telephone sessions ----
    // A real-time party game (mode: 'party'). Any signed-in user (incl.
    // anonymous guests) may read a session, create one, and update it — players
    // are identified by a per-session id rather than their auth uid, and game
    // integrity is enforced app-side via atomic Firestore transactions. Only
    // the creator can delete.
    match /telephone_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() &&
                       request.auth.uid == resource.data.creatorUid;
    }

    // ---- Users ----
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;

      // ---- Friend graph ----
      // A user's friends live in their OWN subcollection and are private to
      // them: only the owner may read or write. The reciprocal edge is written
      // independently by the other person (in THEIR own subcollection), so
      // there is never a need to write into someone else's friends.
      match /friends/{friendId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ---- Private profile ----
    // users/{uid} above is readable by any signed-in user (display name and
    // avatar are public). Personal fields (today: the email address) live in
    // users/{uid}/private/{doc} instead, which only the owner can read or
    // write. Rules do not cascade, so the users block grants nothing here.
    match /users/{userId}/private/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ---- Invites ----
    // One-tap game invites. Anyone signed in may create an invite, but only as
    // themselves (they can't forge another user as the inviter).
    match /invites/{inviteId} {
      // Create: must stamp yourself as the inviter.
      allow create: if isSignedIn() &&
                       request.resource.data.inviterUid == request.auth.uid;

      // Read/update: the named recipient, the inviter, OR — for an as-yet
      // unclaimed email invite — the person whose verified email matches
      // (so claimEmailInvites can stamp recipientUid on sign-in, and the
      // recipient can accept/decline). Decline is modelled as a status update.
      allow read, update: if isSignedIn() && (
        resource.data.recipientUid == request.auth.uid ||
        resource.data.inviterUid == request.auth.uid ||
        (resource.data.recipientUid == null &&
         resource.data.recipientEmailLower == request.auth.token.email)
      );

      // Only the inviter can delete an invite (decline uses update instead).
      allow delete: if isSignedIn() &&
                       resource.data.inviterUid == request.auth.uid;
    }

    // ---- Arena feed ----
    // Every submission becomes a post here, and posting is what unlocks other
    // people's attempts. Read is open to any signed-in user (incl. anonymous
    // guests — grading is explicitly a guest-friendly action); the reveal gate
    // itself is a product rule applied client-side, not a privacy boundary.
    //
    // The crowd counters (gradeCount/gradeSum) turn into game points
    // (CrowdScoreApplier), so every write path below pins them down exactly:
    //   create — counters start at zero, createdAt is the server's clock;
    //   owner  — may edit only caption/text and switch boosted false -> true;
    //   grade  — +1 count, +score sum, +own uid, only together with a NEW
    //            grades/{uid} doc in the same commit, never on your own post;
    //   tap    — tapCount moves forward 1..50, and at most one tapSeconds
    //            bucket (named by lastTapSecond) moves by the same amount.
    // House posts (userId 'house') are seeded with the Admin SDK
    // (functions/scripts/seed_house_posts.js); no client may create, rewrite
    // or delete them — only grade and tap them like any other post.
    match /feed_posts/{postId} {
      function postPath() {
        return /databases/$(database)/documents/feed_posts/$(postId);
      }

      function gradePath(uid) {
        return /databases/$(database)/documents/feed_posts/$(postId)/grades/$(uid);
      }

      function affected() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // A grade: exactly one more grade, by a NEW grader who is not the
      // author, whose grades/{uid} doc is created in the same commit and
      // whose score is exactly what gradeSum moves by.
      function gradeBump() {
        let uid = request.auth.uid;
        let oldGraders = resource.data.get('graderIds', []);
        return affected().hasOnly(['gradeCount', 'gradeSum', 'graderIds']) &&
               uid != resource.data.userId &&
               !(uid in oldGraders) &&
               !exists(gradePath(uid)) &&
               existsAfter(gradePath(uid)) &&
               request.resource.data.graderIds == oldGraders.concat([uid]) &&
               request.resource.data.gradeCount ==
                 resource.data.get('gradeCount', 0) + 1 &&
               request.resource.data.gradeSum ==
                 resource.data.get('gradeSum', 0) +
                   getAfter(gradePath(uid)).data.score;
      }

      // The one tapSeconds bucket [key] moved by exactly [delta] and no other
      // bucket changed.
      function oneBucketMoved(key, delta) {
        let before = resource.data.get('tapSeconds', {});
        let after = request.resource.data.get('tapSeconds', null);
        return key is string &&
               after is map &&
               after.diff(before).affectedKeys().hasOnly([key]) &&
               after[key] == before.get(key, 0) + delta;
      }

      function tapsMovedBy(delta) {
        return delta >= 1 && delta <= 50 &&
               (
                 // A tap with no timeline: the histogram is untouched.
                 !affected().hasAny(['tapSeconds', 'lastTapSecond']) ||
                 // A timed tap: one bucket, named by lastTapSecond, moves by
                 // the same amount as tapCount.
                 oneBucketMoved(request.resource.data.get('lastTapSecond', null), delta)
               );
      }

      // Viewer "that's funny" taps — a sane burst, never a counter rewrite.
      function tapBump() {
        return affected().hasOnly(['tapCount', 'tapSeconds', 'lastTapSecond']) &&
               tapsMovedBy(request.resource.data.tapCount -
                           resource.data.get('tapCount', 0));
      }

      // The author's own edits: the free-text fields, plus the
      // grade-to-get-graded boost, which only ever switches on. Counters,
      // identity, media pointers and timestamps are immutable.
      function ownerEdit() {
        return request.auth.uid == resource.data.userId &&
               affected().hasOnly(['caption', 'text', 'boosted']) &&
               (!affected().hasAny(['boosted']) ||
                (resource.data.get('boosted', false) == false &&
                 request.resource.data.boosted == true));
      }

      // A video post's Storage object must actually live under the poster's
      // own uid — request.resource.data.videoStoragePath is the app's pointer
      // into `submissions/{uid}/{yyyyMMdd}/{slot}` (storage.rules enforces
      // the write there; this is what stops a player from posting a Firestore
      // doc that *claims* someone else's already-uploaded clip).
      function ownVideoPathOk() {
        return request.resource.data.get('mediaType', null) != 'video' ||
               (request.resource.data.get('videoStoragePath', null) is string &&
                request.resource.data.videoStoragePath
                  .matches('^submissions/' + request.auth.uid + '/.*'));
      }

      // A fresh post: every crowd counter at zero and the server's clock as
      // createdAt (so nobody can pin a post to the top with a far-future
      // date). The client writes createdAt as FieldValue.serverTimestamp().
      function freshCounters() {
        let d = request.resource.data;
        return d.gradeCount == 0 &&
               d.gradeSum == 0 &&
               d.graderIds == [] &&
               d.tapCount == 0 &&
               d.boosted == false &&
               d.get('tapSeconds', {}) == {} &&
               !d.keys().hasAny(['lastTapSecond']) &&
               d.createdAt == request.time;
      }

      allow read: if isSignedIn();

      // Post as yourself only — never as the house, never as someone else.
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.get('isHouse', false) == false &&
                       ownVideoPathOk() &&
                       freshCounters();

      allow update: if isSignedIn() && (ownerEdit() || gradeBump() || tapBump());

      // Only the author can delete their post (house posts: nobody).
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;

      // One grade per user per post, written under the grader's own uid, never
      // on your own post, never edited or withdrawn afterwards, and only in
      // the same commit as the matching counter bump on the post.
      match /grades/{graderUid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
                         request.auth.uid == graderUid &&
                         request.auth.uid != get(postPath()).data.userId &&
                         request.resource.data.keys().hasOnly(['score', 'createdAt']) &&
                         request.resource.data.score is int &&
                         request.resource.data.score >= 1 &&
                         request.resource.data.score <= 5 &&
                         !(request.auth.uid in get(postPath()).data.get('graderIds', [])) &&
                         request.auth.uid in getAfter(postPath()).data.get('graderIds', []);
        allow update, delete: if false;
      }
    }

    // ---- Montages ----
    // Server-rendered per-task highlight reels (the "finale" and "moments
    // reel" — see PRODUCT_DIRECTION.md §2.2). A Cloud Function writes these
    // documents with the Admin SDK, which bypasses these rules entirely;
    // client writes are never sanctioned, hence create/update/delete: false
    // rather than any conditional client write path.
    match /montages/{montageId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // ---- Web push subscriptions ----
    // "Tell me when someone grades my clip." One document per user, holding a
    // `subs` map of browser push subscriptions keyed by a hash of the endpoint.
    //
    // These live here rather than on users/{uid} on purpose: that document is
    // readable by ANY signed-in user (see the Users block above), and a push
    // endpoint plus its keys is not something to hand out. This document is
    // readable and writable only by the person it belongs to; the Cloud
    // Function that sends the notification reads it through the Admin SDK,
    // which bypasses rules entirely.
    match /push_subscriptions/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ---- Community tasks ----
    // upvotes is a public tally, so it moves only by +1 and only alongside a
    // NEW community_tasks/{taskId}/votes/{uid} doc in the same commit: one
    // vote per user, never withdrawn, never set wholesale — not even by the
    // author.
    match /community_tasks/{taskId} {
      function taskPath() {
        return /databases/$(database)/documents/community_tasks/$(taskId);
      }

      function votePath(uid) {
        return /databases/$(database)/documents/community_tasks/$(taskId)/votes/$(uid);
      }

      function upvoteBump() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['upvotes']) &&
               request.resource.data.upvotes ==
                 resource.data.get('upvotes', 0) + 1 &&
               !exists(votePath(request.auth.uid)) &&
               existsAfter(votePath(request.auth.uid));
      }

      allow read: if isSignedIn();

      // A user may only submit a task under their own UID, starting at zero.
      allow create: if isSignedIn() &&
                       request.resource.data.submittedBy == request.auth.uid &&
                       request.resource.data.get('upvotes', 0) == 0;

      // The author may edit their task's content (never its author or its
      // tally). Anyone signed in may cast one upvote.
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.submittedBy &&
         !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['upvotes', 'submittedBy'])) ||
        upvoteBump()
      );

      // Only the author can delete their task.
      allow delete: if isSignedIn() && request.auth.uid == resource.data.submittedBy;

      // One vote per user per task, under the voter's own uid, written in the
      // same commit as the +1 on the task.
      match /votes/{voterUid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
                         request.auth.uid == voterUid &&
                         request.resource.data.keys().hasOnly(['createdAt']) &&
                         getAfter(taskPath()).data.get('upvotes', 0) ==
                           get(taskPath()).data.get('upvotes', 0) + 1;
        allow update, delete: if false;
      }
    }
  }
}
