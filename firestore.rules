rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    // True if the named top-level field is identical before and after the write.
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ---- Games ----
    // Who may change what (WP-02). Scores live in players[].totalScore and
    // are written only by the judge or the creator. Rules cannot walk the
    // per-task maps inside `tasks`, so the app re-reads the game inside a
    // transaction and changes only the caller's own entries there.

    // Top-level fields this update changes.
    function gameChangedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function gamePlayers(data) {
      return data.get('players', []);
    }

    function gamePlayerIds(data) {
      return data.get('playerIds', []);
    }

    // Already on the flat roster of uids.
    function isGameMember() {
      return gamePlayerIds(resource.data) is list &&
             request.auth.uid in gamePlayerIds(resource.data);
    }

    // The judge: full rights, except handing the game (or the judge's chair,
    // or the invite code) to someone else.
    function isJudgeUpdate() {
      return request.auth.uid == resource.data.judgeId &&
             !gameChangedKeys().hasAny(['creatorId', 'judgeId', 'inviteCode']);
    }

    // A player records their own start / submission / skip. Only `tasks`
    // moves: not the roster, not the scores, not status or ownership.
    function isPlayerTaskUpdate() {
      return isGameMember() && gameChangedKeys().hasOnly(['tasks']);
    }

    // A player leaves: exactly their own roster entry and uid go, every other
    // entry stays byte-for-byte (so nobody's score moves on the way out), and
    // their per-task statuses may be dropped from `tasks`.
    function isLeave() {
      let before = gamePlayers(resource.data);
      let after = gamePlayers(request.resource.data);
      let removed = before.removeAll(after);
      return isGameMember() &&
             gameChangedKeys().hasOnly(['players', 'playerIds', 'tasks']) &&
             gamePlayerIds(request.resource.data) ==
               gamePlayerIds(resource.data).removeAll([request.auth.uid]) &&
             after.size() == before.size() - 1 &&
             before.hasAll(after) &&
             removed.size() == 1 &&
             removed[0].userId == request.auth.uid;
    }

    // Lobby games take new players; Quick Play and the Starter Pack are
    // created in progress and still do.
    function isJoinable() {
      return resource.data.status == 'lobby' ||
             resource.data.get('gameKind', null) in ['quick', 'starter'];
    }

    function underMaxPlayers(count) {
      let maxPlayers = resource.data.get('settings', {}).get('maxPlayers', null);
      return maxPlayers == null || count <= maxPlayers;
    }

    // A non-member joins: appends exactly themselves, at score 0, to both
    // rosters, and changes nothing else.
    function isJoin() {
      let before = gamePlayers(resource.data);
      let after = gamePlayers(request.resource.data);
      let added = after.removeAll(before);
      return !isGameMember() &&
             isJoinable() &&
             gameChangedKeys().hasOnly(['players', 'playerIds']) &&
             gamePlayerIds(request.resource.data) ==
               gamePlayerIds(resource.data).concat([request.auth.uid]) &&
             after.size() == before.size() + 1 &&
             after.hasAll(before) &&
             added.size() == 1 &&
             added[0].keys().hasOnly(['userId', 'displayName', 'totalScore']) &&
             added[0].userId == request.auth.uid &&
             added[0].totalScore == 0 &&
             underMaxPlayers(after.size());
    }

    // WP-13: everyone grades everyone (no human judge). Absent -> judge mode.
    function isGroupGraded(data) {
      let settings = data.get('settings', null);
      return settings is map && settings.get('judgingMode', 'judge') == 'group';
    }

    // Cloning a public template bumps its popularity counter by exactly one.
    function isCloneCountBump() {
      return resource.data.get('isPublic', false) == true &&
             gameChangedKeys().hasOnly(['cloneCount']) &&
             request.resource.data.cloneCount ==
               resource.data.get('cloneCount', 0) + 1;
    }

    // Read: any signed-in user (needed for join-by-invite-code lookups).
    // Privacy of individual video submissions is enforced at the app level.
    match /games/{gameId} {
      allow read: if isSignedIn();

      // A user may only create a game they own.
      allow create: if isSignedIn() &&
                       request.resource.data.creatorId == request.auth.uid;

      allow update: if isSignedIn() && (
        // Creator: full rights, but the game stays theirs — and once a
        // group-graded game (WP-13) has started, its scores are the server's.
        (request.auth.uid == resource.data.creatorId &&
         !gameChangedKeys().hasAny(['creatorId']) &&
         !(isGroupGraded(resource.data) && resource.data.status != 'lobby' &&
           gameChangedKeys().hasAny(['players']))) ||
        isJudgeUpdate() ||
        isPlayerTaskUpdate() ||
        isLeave() ||
        isJoin() ||
        isCloneCountBump()
      );

      // Only the creator can delete a game.
      allow delete: if isSignedIn() && request.auth.uid == resource.data.creatorId;

      // ---- Friend-game peer grades (WP-13) ----
      // settings.judgingMode == 'group': no judge; once a player has posted
      // their entry for a task they grade every other player's entry, 1..5.
      // One doc per (task, entry, grader), id `{taskId}__{targetUid}__{graderUid}`,
      // written by the grader as themselves only, never on their own entry,
      // never edited or withdrawn (a second grade would be an update, and is
      // refused). The rules check the game itself: group mode, in progress,
      // both players on the roster, the task at taskIndex has this id, the
      // entry is posted and not yet scored, and the grader has posted too
      // (grading is unlocked by posting). Scores are derived from these docs
      // by the onPeerGradeCreated Cloud Function (Admin SDK); no client ever
      // writes a score. Grades are anonymous: only the grader can read theirs.
      match /peer_grades/{gradeId} {
        function theGame() {
          return get(/databases/$(database)/documents/games/$(gameId)).data;
        }

        function peerGradeOk() {
          let d = request.resource.data;
          let g = theGame();
          let uid = request.auth.uid;
          let task = g.tasks[d.taskIndex];
          let statuses = task.get('playerStatuses', {});
          return d.keys().hasOnly(['taskId', 'taskIndex', 'targetUid', 'graderUid', 'score', 'createdAt']) &&
                 d.keys().hasAll(['taskId', 'taskIndex', 'targetUid', 'graderUid', 'score', 'createdAt']) &&
                 d.graderUid == uid &&
                 d.targetUid is string &&
                 d.targetUid != uid &&
                 d.taskId is string &&
                 gradeId == d.taskId + '__' + d.targetUid + '__' + uid &&
                 d.score is int && d.score >= 1 && d.score <= 5 &&
                 d.createdAt == request.time &&
                 isGroupGraded(g) &&
                 g.status == 'inProgress' &&
                 uid in g.get('playerIds', []) &&
                 d.targetUid in g.get('playerIds', []) &&
                 d.taskIndex is int && d.taskIndex >= 0 && d.taskIndex < g.tasks.size() &&
                 task.id == d.taskId &&
                 statuses.get(d.targetUid, {}).get('state', '') == 'submitted' &&
                 statuses.get(uid, {}).get('state', '') in ['submitted', 'judged'];
        }

        allow read: if isSignedIn() && resource.data.graderUid == request.auth.uid;
        allow create: if isSignedIn() && peerGradeOk();
        allow update, delete: if false;
      }

      // The server's ledger of locked peer scores (one per task per player).
      // players[].totalScore in a group game is recomputed from it, so it is
      // written only by Cloud Functions; game members may read it.
      match /peer_results/{resultId} {
        allow read: if isSignedIn() &&
                       request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.get('playerIds', []);
        allow write: if false;
      }
    }

    // ---- Drawing Telephone sessions ----
    // A real-time party game (mode: 'party'). Any signed-in user (incl.
    // anonymous guests) may read a session, create one, and update it — players
    // are identified by a per-session id rather than their auth uid, and game
    // integrity is enforced app-side via atomic Firestore transactions. Only
    // the creator can delete.
    match /telephone_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() &&
                       request.auth.uid == resource.data.creatorUid;
    }

    // ---- Users ----
    match /users/{userId} {
      // WP-11: the plan lives here, written ONLY by Cloud Functions (the
      // RevenueCat webhook / refreshEntitlement, Admin SDK). storage.rules
      // reads `plan` + `planExpiresAt` for the clip caps and the montage
      // trigger reads them for the host, so a client that could write them
      // could grant itself Pro. Clients may create and edit their profile,
      // but never touch any of these keys. Keep in sync with
      // functions/src/revenuecat.js.
      function serverOwnedPlanFields() {
        return ['plan', 'planExpiresAt', 'planLapsedAt', 'planSource',
                'planStatus', 'planWillRenew', 'planBillingIssue',
                'planCancelReason', 'planProductId', 'planPendingProductId',
                'planStore', 'planEnvironment', 'planUpdatedAt',
                'planLastEventMs', 'planLastEventType', 'usage'];
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId &&
                       !request.resource.data.keys().hasAny(serverOwnedPlanFields());
      allow update: if isSignedIn() && request.auth.uid == userId &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(serverOwnedPlanFields());
      allow delete: if isSignedIn() && request.auth.uid == userId;

      // ---- Friend graph ----
      // A user's friends live in their OWN subcollection and are private to
      // them: only the owner may read or write. The reciprocal edge is written
      // independently by the other person (in THEIR own subcollection), so
      // there is never a need to write into someone else's friends.
      match /friends/{friendId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ---- Private profile ----
    // users/{uid} above is readable by any signed-in user (display name and
    // avatar are public). Personal fields (today: the email address) live in
    // users/{uid}/private/{doc} instead, which only the owner can read or
    // write. Rules do not cascade, so the users block grants nothing here.
    match /users/{userId}/private/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ---- Invites ----
    // One-tap game invites. Anyone signed in may create an invite, but only as
    // themselves (they can't forge another user as the inviter).
    match /invites/{inviteId} {
      // Create: must stamp yourself as the inviter.
      allow create: if isSignedIn() &&
                       request.resource.data.inviterUid == request.auth.uid;

      // Read/update: the named recipient, the inviter, OR — for an as-yet
      // unclaimed email invite — the person whose verified email matches
      // (so claimEmailInvites can stamp recipientUid on sign-in, and the
      // recipient can accept/decline). Decline is modelled as a status update.
      allow read, update: if isSignedIn() && (
        resource.data.recipientUid == request.auth.uid ||
        resource.data.inviterUid == request.auth.uid ||
        (resource.data.recipientUid == null &&
         resource.data.recipientEmailLower == request.auth.token.email)
      );

      // Only the inviter can delete an invite (decline uses update instead).
      allow delete: if isSignedIn() &&
                       resource.data.inviterUid == request.auth.uid;
    }

    // ---- Arena feed ----
    // Every submission becomes a post here, and posting is what unlocks other
    // people's attempts. Read is open to any signed-in user (incl. anonymous
    // guests — grading is explicitly a guest-friendly action); the reveal gate
    // itself is a product rule applied client-side, not a privacy boundary.
    //
    // The crowd counters (gradeCount/gradeSum) turn into game points
    // (CrowdScoreApplier), so every write path below pins them down exactly:
    //   create — counters start at zero, createdAt is the server's clock;
    //   owner  — may edit only caption/text and switch boosted false -> true;
    //   grade  — +1 count, +score sum, +own uid, only together with a NEW
    //            grades/{uid} doc in the same commit, never on your own post;
    //   tap    — tapCount moves forward 1..50, and at most one tapSeconds
    //            bucket (named by lastTapSecond) moves by the same amount.
    // House posts (userId 'house') are seeded with the Admin SDK
    // (functions/scripts/seed_house_posts.js); no client may create, rewrite
    // or delete them — only grade and tap them like any other post.
    match /feed_posts/{postId} {
      function postPath() {
        return /databases/$(database)/documents/feed_posts/$(postId);
      }

      function gradePath(uid) {
        return /databases/$(database)/documents/feed_posts/$(postId)/grades/$(uid);
      }

      function affected() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // A grade: exactly one more grade, by a NEW grader who is not the
      // author, whose grades/{uid} doc is created in the same commit and
      // whose score is exactly what gradeSum moves by.
      function gradeBump() {
        let uid = request.auth.uid;
        let oldGraders = resource.data.get('graderIds', []);
        return affected().hasOnly(['gradeCount', 'gradeSum', 'graderIds']) &&
               uid != resource.data.userId &&
               !(uid in oldGraders) &&
               !exists(gradePath(uid)) &&
               existsAfter(gradePath(uid)) &&
               request.resource.data.graderIds == oldGraders.concat([uid]) &&
               request.resource.data.gradeCount ==
                 resource.data.get('gradeCount', 0) + 1 &&
               request.resource.data.gradeSum ==
                 resource.data.get('gradeSum', 0) +
                   getAfter(gradePath(uid)).data.score;
      }

      // The one tapSeconds bucket [key] moved by exactly [delta] and no other
      // bucket changed.
      function oneBucketMoved(key, delta) {
        let before = resource.data.get('tapSeconds', {});
        let after = request.resource.data.get('tapSeconds', null);
        return key is string &&
               after is map &&
               after.diff(before).affectedKeys().hasOnly([key]) &&
               after[key] == before.get(key, 0) + delta;
      }

      function tapsMovedBy(delta) {
        return delta >= 1 && delta <= 50 &&
               (
                 // A tap with no timeline: the histogram is untouched.
                 !affected().hasAny(['tapSeconds', 'lastTapSecond']) ||
                 // A timed tap: one bucket, named by lastTapSecond, moves by
                 // the same amount as tapCount.
                 oneBucketMoved(request.resource.data.get('lastTapSecond', null), delta)
               );
      }

      // Viewer "that's funny" taps — a sane burst, never a counter rewrite.
      function tapBump() {
        return affected().hasOnly(['tapCount', 'tapSeconds', 'lastTapSecond']) &&
               tapsMovedBy(request.resource.data.tapCount -
                           resource.data.get('tapCount', 0));
      }

      // The author's own edits: the free-text fields, the WP-09 public-share
      // switch (either way, a bool), plus the grade-to-get-graded boost,
      // which only ever switches on. Counters, identity, media pointers and
      // timestamps are immutable.
      function ownerEdit() {
        return request.auth.uid == resource.data.userId &&
               affected().hasOnly(['caption', 'text', 'boosted', 'shareable']) &&
               shareableOk() &&
               (!affected().hasAny(['boosted']) ||
                (resource.data.get('boosted', false) == false &&
                 request.resource.data.boosted == true));
      }

      // WP-09: `shareable` decides whether the public /p/ share page renders
      // this post (functions/src/share_page.js). Absent = the default (public
      // for Starter Pack posts, private for friend games); when present it
      // must be a bool.
      function shareableOk() {
        return !request.resource.data.keys().hasAny(['shareable']) ||
               request.resource.data.shareable is bool;
      }

      // A video post's Storage object must actually live under the poster's
      // own uid — request.resource.data.videoStoragePath is the app's pointer
      // into `submissions/{uid}/{yyyyMMdd}/{slot}` (storage.rules enforces
      // the write there; this is what stops a player from posting a Firestore
      // doc that *claims* someone else's already-uploaded clip).
      function ownVideoPathOk() {
        return request.resource.data.get('mediaType', null) != 'video' ||
               (request.resource.data.get('videoStoragePath', null) is string &&
                request.resource.data.videoStoragePath
                  .matches('^submissions/' + request.auth.uid + '/.*'));
      }

      // A fresh post: every crowd counter at zero and the server's clock as
      // createdAt (so nobody can pin a post to the top with a far-future
      // date). The client writes createdAt as FieldValue.serverTimestamp().
      function freshCounters() {
        let d = request.resource.data;
        return d.gradeCount == 0 &&
               d.gradeSum == 0 &&
               d.graderIds == [] &&
               d.tapCount == 0 &&
               d.boosted == false &&
               d.get('tapSeconds', {}) == {} &&
               !d.keys().hasAny(['lastTapSecond']) &&
               d.createdAt == request.time;
      }

      // WP-08: the transcoded-clip pointers are written only by the
      // onClipUploaded / onFeedPostCreated Cloud Functions (Admin SDK). The
      // app prefers playbackUrl over videoUrl, so a client-chosen value would
      // let a post play any URL at all; ownerEdit() already keeps them out of
      // updates, this keeps them out of creates.
      function noServerPlaybackFields() {
        return !request.resource.data.keys().hasAny(['playbackUrl', 'posterUrl']);
      }

      // A post its owner made private (`shareable == false`). Friend-game
      // posts with the flag unset still reach the cross-game Arena by design
      // (games.settings.shareToArena), where strangers list and grade them,
      // so only an explicit "no" makes a post private.
      function isPrivatePost() {
        return resource.data.get('shareable', null) == false;
      }

      // The reader is on the roster of the game the post was made in.
      function inPostGame() {
        let gameId = resource.data.get('gameId', null);
        let gamePath = /databases/$(database)/documents/games/$(gameId);
        return gameId is string && gameId != '' && exists(gamePath) &&
               request.auth.uid in get(gamePath).data.get('playerIds', []);
      }

      // By id: a private post only for its author and its game's players.
      allow get: if isSignedIn() &&
                    (!isPrivatePost() ||
                     request.auth.uid == resource.data.userId ||
                     inPostGame());

      // Queries (the Arena queue, Watch together, your own posts) cannot be
      // filtered on `shareable` without dropping every post that lacks the
      // field, so they stay open to signed-in users; the app's Arena queue
      // skips private posts itself.
      allow list: if isSignedIn();

      // Post as yourself only — never as the house, never as someone else.
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.get('isHouse', false) == false &&
                       ownVideoPathOk() &&
                       noServerPlaybackFields() &&
                       shareableOk() &&
                       freshCounters();

      allow update: if isSignedIn() && (ownerEdit() || gradeBump() || tapBump());

      // Only the author can delete their post (house posts: nobody).
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;

      // One grade per user per post, written under the grader's own uid, never
      // on your own post, never edited or withdrawn afterwards, and only in
      // the same commit as the matching counter bump on the post.
      match /grades/{graderUid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
                         request.auth.uid == graderUid &&
                         request.auth.uid != get(postPath()).data.userId &&
                         request.resource.data.keys().hasOnly(['score', 'createdAt']) &&
                         request.resource.data.score is int &&
                         request.resource.data.score >= 1 &&
                         request.resource.data.score <= 5 &&
                         !(request.auth.uid in get(postPath()).data.get('graderIds', [])) &&
                         request.auth.uid in getAfter(postPath()).data.get('graderIds', []);
        allow update, delete: if false;
      }
    }

    // ---- Share attributions (WP-09) ----
    // share_attributions/{uid}: "this player's first post answered a shared
    // challenge" — feeds a later "X took your challenge" push. Written once by
    // the new player, as themselves, pointing at their own post and at a post
    // that exists; never edited, never read by clients (the Admin SDK reads
    // it server-side). Create-only, so only the FIRST challenge counts.
    match /share_attributions/{uid} {
      allow read: if false;
      allow create: if isSignedIn() &&
                       request.auth.uid == uid &&
                       request.resource.data.keys().hasOnly(
                         ['fromPostId', 'postId', 'taskId', 'createdAt']) &&
                       request.resource.data.fromPostId is string &&
                       request.resource.data.postId is string &&
                       request.resource.data.taskId is string &&
                       request.resource.data.fromPostId != request.resource.data.postId &&
                       request.resource.data.createdAt == request.time &&
                       exists(/databases/$(database)/documents/feed_posts/$(request.resource.data.fromPostId)) &&
                       get(/databases/$(database)/documents/feed_posts/$(request.resource.data.postId)).data.userId == uid;
      allow update, delete: if false;
    }

    // ---- Montages ----
    // Server-rendered per-task highlight reels (the "finale" and "moments
    // reel" — see PRODUCT_DIRECTION.md §2.2). A Cloud Function writes these
    // documents with the Admin SDK, which bypasses these rules entirely;
    // client writes are never sanctioned, hence create/update/delete: false
    // rather than any conditional client write path.
    match /montages/{montageId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // ---- Clip transcode metadata (WP-08) ----
    // clips/{uid}_{day}_{slot}: one doc per uploaded clip, the transcode's
    // claim/lock and the retention clock (createdAt) for the WP-11 sweep.
    // Written and read only by Cloud Functions (Admin SDK); clients get the
    // URLs they need through the feed post's playbackUrl / posterUrl.
    match /clips/{clipId} {
      allow read, write: if false;
    }

    // ---- Web push subscriptions ----
    // "Tell me when someone grades my clip." One document per user, holding a
    // `subs` map of browser push subscriptions keyed by a hash of the endpoint.
    //
    // These live here rather than on users/{uid} on purpose: that document is
    // readable by ANY signed-in user (see the Users block above), and a push
    // endpoint plus its keys is not something to hand out. This document is
    // readable and writable only by the person it belongs to; the Cloud
    // Function that sends the notification reads it through the Admin SDK,
    // which bypasses rules entirely.
    match /push_subscriptions/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ---- Community tasks ----
    // upvotes is a public tally, so it moves only by +1 and only alongside a
    // NEW community_tasks/{taskId}/votes/{uid} doc in the same commit: one
    // vote per user, never withdrawn, never set wholesale — not even by the
    // author.
    match /community_tasks/{taskId} {
      function taskPath() {
        return /databases/$(database)/documents/community_tasks/$(taskId);
      }

      function votePath(uid) {
        return /databases/$(database)/documents/community_tasks/$(taskId)/votes/$(uid);
      }

      function upvoteBump() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['upvotes']) &&
               request.resource.data.upvotes ==
                 resource.data.get('upvotes', 0) + 1 &&
               !exists(votePath(request.auth.uid)) &&
               existsAfter(votePath(request.auth.uid));
      }

      allow read: if isSignedIn();

      // A user may only submit a task under their own UID, starting at zero.
      allow create: if isSignedIn() &&
                       request.resource.data.submittedBy == request.auth.uid &&
                       request.resource.data.get('upvotes', 0) == 0;

      // The author may edit their task's content (never its author or its
      // tally). Anyone signed in may cast one upvote.
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.submittedBy &&
         !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['upvotes', 'submittedBy'])) ||
        upvoteBump()
      );

      // Only the author can delete their task.
      allow delete: if isSignedIn() && request.auth.uid == resource.data.submittedBy;

      // One vote per user per task, under the voter's own uid, written in the
      // same commit as the +1 on the task.
      match /votes/{voterUid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
                         request.auth.uid == voterUid &&
                         request.resource.data.keys().hasOnly(['createdAt']) &&
                         getAfter(taskPath()).data.get('upvotes', 0) ==
                           get(taskPath()).data.get('upvotes', 0) + 1;
        allow update, delete: if false;
      }
    }
  }
}
